<?xml version="1.0"?>
<ruleset name="Foliora">
	<description>WordPress coding standards and PHP 7.4+ compatibility for Foliora (dev / CI). Plugin Check covers WP.org lint.</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/vendor/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<!-- Hook names use a "/" namespace (foliora/viewer_atts) on purpose; it is the public contract in docs/HOOKS.md. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="foliora"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="foliora"/>
				<element value="Foliora"/>
				<element value="FOLIORA"/>
			</property>
		</properties>
	</rule>

	<arg name="extensions" value="php"/>
	<arg value="s"/>
</ruleset>
