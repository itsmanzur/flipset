<wpml-config>
	<gutenberg-blocks>
		<gutenberg-block type="flipset/viewer" translate="1">
			<key name="file" />
			<key name="title" />
		</gutenberg-block>
		<gutenberg-block type="flipset/library" translate="0" />
	</gutenberg-blocks>
	<shortcodes>
		<shortcode>
			<tag>flipset</tag>
			<attributes>
				<attribute encoding="url">file</attribute>
				<attribute>title</attribute>
			</attributes>
		</shortcode>
	</shortcodes>
	<custom-fields>
		<custom-field action="copy">_flipset_extracted_text</custom-field>
		<custom-field action="copy">_flipset_extracted_pages</custom-field>
		<custom-field action="copy">_flipset_text_indexed</custom-field>
		<custom-field action="copy">_flipset_search_index</custom-field>
		<custom-field action="copy">_flipset_thumbnail_id</custom-field>
	</custom-fields>
</wpml-config>
