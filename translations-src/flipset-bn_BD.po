#. Plugin Name of the plugin
#: flipset.php
msgid "Flipset – PDF Viewer, PDF Embed, 3D Flipbook & Document Library"
msgstr "Flipset – PDF ভিউয়ার, PDF এমবেড, 3D ফ্লিপবুক ও ডকুমেন্ট লাইব্রেরি"

#. Plugin URI of the plugin
#: flipset.php
msgid "https://flipset.thereadscope.com"
msgstr "https://flipset.thereadscope.com"

#. Description of the plugin
#: flipset.php
msgid "Embed PDFs with a fast PDF viewer, 3D flipbook and document library. Searchable PDF text, accessible, no CDN. Works with Gutenberg, Elementor, Divi."
msgstr "দ্রুত পিডিএফ ভিউয়ার, ৩ডি ফ্লিপবুক ও ডকুমেন্ট লাইব্রেরি দিয়ে পিডিএফ এমবেড করুন। সার্চযোগ্য পিডিএফ টেক্সট, অ্যাক্সেসিবল, কোনো CDN নেই। Gutenberg, Elementor, Divi-র সাথে কাজ করে।"

#. Author of the plugin
#: flipset.php
msgid "The Readscope"
msgstr "The Readscope"

#. Author URI of the plugin
#: flipset.php
msgid "https://thereadscope.com"
msgstr "https://thereadscope.com"

