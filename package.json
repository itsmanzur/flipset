{
	"name": "flipset",
	"private": true,
	"description": "Dev tooling for Flipset. Not shipped in the WP.org zip.",
	"scripts": {
		"build": "node bin/build-assets.js",
		"wp-env": "wp-env",
		"build:zip": "node bin/build-assets.js && node bin/build-zip.js",
		"test:php": "phpunit",
		"test:e2e": "playwright test",
		"phpcs": "phpcs -n"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0",
		"@wordpress/env": "^10.17.0",
		"esbuild": "0.24.2"
	}
}
